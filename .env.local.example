# Local-only values for docker-compose.local.yml. Generate secrets per run.
# Required. Generate one per run without persisting it:
# export MPIPS_API_KEY="$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
MPIPS_API_KEY=
MPIPS_LOCAL_PORT=8014
MPIPS_LOCAL_UID=1000
MPIPS_LOCAL_GID=1000
MPIPS_LOCAL_RUNTIME_DIR=/tmp/mpips-local-dicom-burn-in
MPIPS_CALIBRATION_DIR=/tmp/mpips-local-dicom-burn-in/calibration
MPIPS_LAUNCHER_DIR=/tmp/mpips-local-dicom-burn-in/socket
MPIPS_WORKER_USER=1000:1000
MPIPS_VERSION=local
