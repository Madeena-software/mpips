# syntax=docker/dockerfile:1.7

FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS worker-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLCONFIGDIR=/tmp \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:${PATH}"

COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libglib2.0-0 \
        libgl1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra imager --extra npz-worker --no-install-project

COPY mpips/conversion/worker.py ./mpips/conversion/worker.py
COPY mpips/workflows/imager_pipeline ./mpips/workflows/imager_pipeline
COPY mpips/pipelines ./mpips/pipelines
COPY mpips/processing ./mpips/processing
COPY mpips/__init__.py ./mpips/__init__.py
COPY mpips/workflows/__init__.py ./mpips/workflows/__init__.py
COPY mpips/storage.py ./mpips/storage.py

RUN groupadd --system --gid 10001 mpips \
    && useradd --system --uid 10001 --gid mpips --home-dir /app mpips \
    && chown -R mpips:mpips /app

USER 10001:10001

ENTRYPOINT ["tini", "--", "python", "-m", "mpips.conversion.worker"]
