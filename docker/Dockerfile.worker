# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS worker-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libglib2.0-0 \
        libgl1 \
        tini \
    && pip install --no-cache-dir uv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra npz-worker --no-install-project

COPY mpips/conversion/worker.py ./mpips/conversion/worker.py
COPY mpips/workflows/imager_pipeline ./mpips/workflows/imager_pipeline
COPY mpips/engine/imager_pipeline/pipeline.py ./mpips/engine/imager_pipeline/pipeline.py
COPY mpips/__init__.py ./mpips/__init__.py
COPY mpips/conversion/__init__.py ./mpips/conversion/__init__.py
COPY mpips/workflows/__init__.py ./mpips/workflows/__init__.py
COPY mpips/engine/__init__.py ./mpips/engine/__init__.py

RUN groupadd --system --gid 10001 mpips \
    && useradd --system --uid 10001 --gid mpips --home-dir /app mpips \
    && chown -R mpips:mpips /app

USER 10001:10001

ENTRYPOINT ["tini", "--", "python", "-m", "mpips.conversion.worker"]
