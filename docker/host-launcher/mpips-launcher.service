[Unit]
Description=MPIPS NPZ Worker Host Launcher Service
Documentation=https://github.com/Madeena-software/mpips
Requires=docker.service
After=docker.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/var/www/mpips-runtime/launcher.env
Environment=MPIPS_WORKER_IMAGE=mpips-npz-worker:internal-beta
Environment=MPIPS_WORKSPACE_ROOT=/tmp/mpips-workspaces
Environment=MPIPS_LAUNCHER_SOCKET_PATH=/var/www/mpips-runtime/launcher/launcher.sock
ExecStart=/usr/bin/python3 /var/www/mpips-runtime/mpips-launcher.py
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
