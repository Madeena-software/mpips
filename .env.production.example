DEV_AUTH_BYPASS=false
DEV_BEARER_TOKEN=
MADEENA_IDP_JWKS_URL=https://sso.madeena.com/.well-known/jwks.json
MADEENA_REQUIRED_SCOPES=image:process,nodes:read

REDIS_URL=redis://:replace-with-redis-password@redis.example.internal:6379/0
CELERY_BROKER_URL=redis://:replace-with-redis-password@redis.example.internal:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-redis-password@redis.example.internal:6379/1

AWS_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=madeena-media-production
AWS_ENDPOINT_URL=

WEBHOOK_SECRET=replace-with-shared-webhook-secret

PORT=8000
MPIPS_API_WORKERS=2
MPIPS_WORKER_LOG_LEVEL=info
MPIPS_WORKER_CONCURRENCY=2
MPIPS_WORKER_MAX_TASKS_PER_CHILD=100
MPIPS_WORKER_PREFETCH_MULTIPLIER=1
MPIPS_WORKER_TASK_SOFT_TIME_LIMIT=900
MPIPS_WORKER_TASK_TIME_LIMIT=960
