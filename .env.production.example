MPIPS_ENVIRONMENT=production
MPIPS_VERSION=<commit-sha>
MPIPS_LAUNCHER_GID=<host-launcher-group-id>
MPIPS_RUNTIME_UID=<runner-uid>
MPIPS_RUNTIME_GID=<runner-gid>
REMOTE_PATH=/var/www/mpips-runtime

# Redis job state & Celery broker
REDIS_URL=redis://:replace-with-redis-password@redis.example.internal:6379/0
CELERY_BROKER_URL=redis://:replace-with-redis-password@redis.example.internal:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-redis-password@redis.example.internal:6379/1

# S3 Storage Configuration
AWS_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=madeena-media-production
AWS_ENDPOINT_URL=

# Webhook signing
WEBHOOK_SECRET=replace-with-shared-webhook-secret

# Execution concurrency and limits
PORT=8000
MPIPS_API_WORKERS=1
MPIPS_MAX_HTTP_REQUEST_BODY_BYTES=110100480
MPIPS_DICOM_MAX_MANIFEST_BYTES=1048576
MPIPS_DICOM_MAX_RADIOGRAPH_BYTES=52428800
MPIPS_DICOM_MAX_GAIN_BYTES=52428800
MPIPS_DICOM_MAX_TOTAL_BYTES=104857600
MPIPS_DICOM_MAX_TIFF_BYTES=104857600
MPIPS_DICOM_PROCESS_TIMEOUT_SECONDS=300
MPIPS_DICOM_IDEMPOTENCY_TTL_SECONDS=86400
MPIPS_DICOM_WORKER_CPU_SECONDS=120
MPIPS_DICOM_WORKER_MEMORY_BYTES=2147483648
MPIPS_DICOM_MAX_CONCURRENT_CONVERSIONS=4
